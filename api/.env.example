# slot-relay 予約 API の環境変数（値は入れない・実値は Coolify の環境変数に設定する）
# 一次情報は docs/DEPLOY.md
#
# ローカルは compose.yaml が基本的な値を渡すので、このファイルの複製（api/.env）は
# Google OAuth を実際に試すときだけ作ればよい。

# --- 基本 ---
RAILS_ENV=production
PORT=3001
# Coolify の PostgreSQL 接続 URL
DATABASE_URL=
# 本番で必須。`openssl rand -hex 64` で生成する。
# このプロジェクトは Rails の暗号化 credentials を使わず、秘密はすべて環境変数に置く
# （config/master.key をイメージに同梱しないため、これが無いと production で起動できない）。
#
# **注意**: Google の refresh token はこの値から導出した鍵で暗号化して DB に保存している。
# 値を差し替えると復号できなくなり、Google の再連携が必要になる（docs/SECURITY.md）。
SECRET_KEY_BASE=
# 公開 URL。キャンセル URL・メールのリンク・OAuth のリダイレクト URI の生成に使う
PUBLIC_BASE_URL=https://booking-api.genba-tsunagu.jp
# Host ヘッダ検証（カンマ区切り。未設定なら検証しない）
ALLOWED_HOSTS=booking-api.genba-tsunagu.jp
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5

# --- 管理 API ---
# 32 文字以上のランダム文字列（`openssl rand -base64 48` など）。未設定なら管理 API は 503
ADMIN_API_KEY=

# --- Google カレンダー（ユーザー OAuth） ---
# Google Cloud で「OAuth 2.0 クライアント ID」を種別「ウェブ アプリケーション」で作る。
# 設定手順は docs/DEPLOY.md、選定の経緯は
# docs/plans/2026-07-30-google-oauth-calendar-selection.md。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 省略時は PUBLIC_BASE_URL + /v1/admin/google/oauth/callback。
# Google Cloud の「承認済みのリダイレクト URI」と完全一致させること。
GOOGLE_OAUTH_REDIRECT_URI=

# 実際に使うカレンダーは、連携後に設定画面（/v1/admin/google/setup）から選ぶ。
# 以下は予約メニュー側で未選択のときに使う既定値（省略可）。
GOOGLE_BUSY_CALENDAR_IDS=
GOOGLE_BOOKING_CALENDAR_ID=

# --- メール（SMTP） ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@genba-tsunagu.jp
ADMIN_NOTIFICATION_EMAIL=

# --- Bot 対策 ---
# 未設定だと Turnstile 検証をスキップする（本番では必ず設定する）
TURNSTILE_SECRET_KEY=

# --- キャンセル画面（サイト側に置く場合） ---
# 未設定なら PUBLIC_BASE_URL を使う
CANCEL_URL_BASE=https://genba-tsunagu.jp/booking

# --- レートリミット（省略時は既定値） ---
PUBLIC_RATE_LIMIT_PER_IP=120
PUBLIC_RATE_LIMIT_PERIOD=60
RESERVATION_RATE_LIMIT_PER_IP=5
RESERVATION_RATE_LIMIT_PERIOD=600
ADMIN_RATE_LIMIT_PER_IP=60
ADMIN_RATE_LIMIT_PERIOD=60

source "https://rubygems.org"

gem "rails", "~> 8.1.3", ">= 8.1.3.1"

# PostgreSQL（btree_gist の排他制約を使うため PostgreSQL 固有機能に依存する）
gem "pg", "~> 1.1"
gem "puma", ">= 5.0"

# IP / 予約メニュー単位のレートリミット
gem "rack-attack"

# Google Calendar 連携（サービスアカウント）
gem "google-apis-calendar_v3", "~> 0.44"
gem "googleauth", "~> 1.11"

gem "tzinfo-data", platforms: %i[ windows jruby ]
gem "bootsnap", require: false
gem "thruster", require: false

group :development, :test do
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # 依存パッケージの既知脆弱性を監査（config/bundler-audit.yml で除外設定）
  gem "bundler-audit", require: false

  gem "dotenv-rails"

  # Google Calendar / Turnstile への外部 HTTP 通信をテストで遮断・スタブする
  gem "webmock"
end

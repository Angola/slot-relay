# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# ログ・一時ファイル
*.log
tmp/
*.tmp

# 環境変数・シークレット（リポジトリに平文で置かない）
.env
.env.*
!.env.example
*.pem
*.key

# 依存・ビルド成果物
node_modules/
coverage/

# api/（Ruby on Rails）
/api/log/*
!/api/log/.keep
/api/tmp/*
!/api/tmp/.keep
!/api/tmp/pids
/api/tmp/pids/*
!/api/tmp/pids/.keep
/api/storage/*
!/api/storage/.keep
/api/.bundle/
/api/vendor/bundle/

# web/（Next.js）
/web/.next/
/web/out/
/web/next-env.d.ts
/web/*.tsbuildinfo

# Terraform（IaC を使う場合。認証情報を含むため必ず除外）
# *.tfvars
# *.tfstate

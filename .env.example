# ローカル開発の compose 設定（`cp .env.example .env` して使う。値は自由に変えてよい）。
# アプリの秘密情報はここではなく api/.env に置く（api/.env.example を参照）。

# --- ポート ---
# 3000 / 3001 は他プロジェクトと衝突しやすいので既定値をずらしている。
# 空いているなら API_PORT=3001 / WEB_PORT=3000 に戻してよい。
API_PORT=3011
WEB_PORT=3012
DB_PORT=55432

# --- 実行ユーザー ---
# バインドマウント先に root 所有のファイルを作らないよう、ホストと同じ uid/gid で動かす。
# `id -u` / `id -g` の値が 1000 以外のときだけ設定する。
# DOCKER_UID=1000
# DOCKER_GID=1000
